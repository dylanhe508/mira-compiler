# bench_pressure_spill_long 计时版:高寄存器压力 + 函数调用,5e6 轮
fn hot_step(x, salt) {
    (x * 17 + salt) & 9223372036854775807
}

fn pressure_call(x) {
    mut a = x + 1;
    mut b = x * 3 + 2;
    mut c = x * 5 + 3;
    mut d = x * 7 + 4;
    mut e = x * 11 + 5;
    mut f = x * 13 + 6;
    mut g = x * 17 + 7;
    mut h = x * 19 + 8;
    mut i = x * 23 + 9;
    mut j = x * 29 + 10;
    mut k = x * 31 + 11;
    mut l = x * 37 + 12;
    mut called = hot_step(x, 99);
    (called + a * 3 + b * 5 + c * 7 + d * 11 + e * 13 + f * 17 +
        g * 19 + h * 23 + i * 29 + j * 31 + k * 37 + l * 41) &
        9223372036854775807
}

fn run_pressure(rounds) {
    mut total = 0;
    mut n = 0;
    while (n < rounds) {
        total = (total + pressure_call(n + 24680)) & 9223372036854775807;
        n = n + 1;
    }
    total
}

fn main() {
    mut start_time = clock-ns();
    mut result = run_pressure(5000000);
    mut end_time = clock-ns();
    print("result=");
    print(result);
    print("elapsed_ns=");
    print(end_time - start_time);
}
