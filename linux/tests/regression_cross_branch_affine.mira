fn branchy_recurrence(n) {
    mut checksum = 0;
    mut bucket0 = 0;
    mut bucket1 = 0;
    mut bucket2 = 0;
    mut i = 0;
    while (i < n) {
        mut sensor = ((i * 1103515245 + 12345) >> 7) & 65535;
        mut adjusted = sensor * ((i & 31) + 1) + ((i >> 3) & 255);
        if ((adjusted & 7) < 3) {
            bucket0 = bucket0 + adjusted;
        } else {
            if ((adjusted & 7) < 6) {
                bucket1 = bucket1 + (adjusted ^ (i * 17));
            } else {
                bucket2 = bucket2 + (adjusted / ((i & 15) + 1));
            }
        }
        checksum = checksum + ((bucket0 ^ bucket1) + bucket2 + adjusted);
        i = i + 1;
    }
    checksum + bucket0 + bucket1 + bucket2
}

fn main() {
    print(branchy_recurrence(20000));
}
