fn affine_profitability() {
    mut total = 0;
    mut i = 3;
    while (i < 103) {
        total = total + i * 3;
        total = total + i * 5;
        total = total + i * 7;
        total = total + i * 11;
        total = total + i * 13;
        total = total + i * 17;
        total = total + i * 19;
        total = total + i * 23;
        total = total + i * 23;
        i = i + 1;
    }
    total
}

fn main() {
    print(affine_profitability());
}
