fn fib(n) {
    mut a = 0;
    mut b = 1;
    mut i = 0;
    while (i < n) {
        mut next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    b
}

fn main() {
    mut start_time = clock-ns();
    mut result = fib(100000000);
    mut end_time = clock-ns();
    print("result=");
    print(result);
    print("elapsed_ns=");
    print(end_time - start_time);
}
