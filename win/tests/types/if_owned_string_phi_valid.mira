fn choose_owned(flag: bool) -> str {
    if (flag) {
        "mi" "ra" str-cat
    } else {
        "ty" "ped" str-cat
    }
}

fn consume(value: str) -> str { value }

fn choose_mixed(flag: bool) -> str {
    if (flag) {
        "mi" "xed" str-cat
    } else {
        "borrowed"
    }
}

fn main() -> void {
    print(consume(choose_owned(true)));
    print(consume(choose_owned(false)));
    print(consume(choose_mixed(true)));
    print(consume(choose_mixed(false)));
}
