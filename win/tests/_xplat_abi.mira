fn six_args(a, b, c, d, e, f) {
    a + b + c + d + e + f
}

fn sum_loop(n) {
    mut s = 0;
    mut i = 0;
    while (i < n) {
        s = s + i;
        i = i + 1;
    }
    s
}

fn fact(n) {
    if (n <= 1) { 1 } else { n * fact(n - 1) }
}

fn main() {
    mut r1 = six_args(10, 20, 30, 40, 50, 60);
    mut r3 = sum_loop(100);
    mut r4 = fact(10);
    print(r1);
    print(r3);
    print(r4);
}
