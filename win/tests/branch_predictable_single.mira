fn work(n) {
    mut sum = 0;
    mut x = 1;
    mut i = 0;
    while (i < n) {
        x = x * 6364136223846793005 + 1;
        if (i < n - 1) { sum = sum + x; }
        else { sum = sum - x; }
        i = i + 1;
    }
    sum
}

fn main() {
    mut begin = clock-ns();
    mut result = work(50000000);
    mut end = clock-ns();
    print(result);
    print(end - begin);
}
