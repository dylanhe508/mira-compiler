fn work(n) {
    mut sum = 0;
    mut i = 0;
    mut k = 0;
    while (i < n) {
        if (k < 90) { sum = sum + i; }
        else { sum = sum - i; }
        k = k + 1;
        if (k == 100) { k = 0; }
        i = i + 1;
    }
    sum
}
fn main() {
    mut start_time = clock-ns();
    mut result = work(50000000);
    mut end_time = clock-ns();
    print("result="); print(result);
    print("elapsed_ns="); print(end_time - start_time);
}
