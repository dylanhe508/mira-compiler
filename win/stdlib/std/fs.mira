extern fn __mira_file_read(path: str) -> str;
extern fn __mira_file_write(path: str, content: str);
extern fn __mira_file_append(path: str, content: str);
extern fn __mira_file_exists(path: str) -> i64;
extern fn __mira_file_delete(path: str);

fn read(path) {
    __mira_file_read(path)
}

fn write(path, content) {
    __mira_file_write(path, content);
}

fn append(path, content) {
    __mira_file_append(path, content);
}

fn exists(path) {
    __mira_file_exists(path)
}

fn remove(path) {
    __mira_file_delete(path);
}
